# ---------------------------------------------------------------------------
# SAT-7 Promo — environment variables
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local` to GitHub.
# ---------------------------------------------------------------------------

# Supabase project settings -> Project Settings -> API
# Found at: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / "publishable" key. Safe to expose to the browser:
# Row Level Security is what actually protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# SERVER-ONLY — never prefix with NEXT_PUBLIC_, never expose to the browser.
# Supabase project settings -> API -> service_role / "secret" key.
# Used only in server actions for privileged operations (user provisioning,
# admin resets, aggregate reporting) where RLS would otherwise block you.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public application URL. Used to build password-reset redirect links.
# Production: https://promolb.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000