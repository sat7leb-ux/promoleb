# ---------------------------------------------------------------------------
# SAT-7 Promo — environment variables (Neon)
# Copy to `.env.local` and fill in real values.
# NEVER commit `.env.local`.
#
# Generate these automatically with:
#   neon link --project-id <project-id> --branch production -y
#   # or
#   neon env pull
# ---------------------------------------------------------------------------

# Neon connection string — pooled, for application traffic.
# Neon Console -> Connect, or from `neon env pull`.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Unpooled connection. Use for migrations, long transactions and anything that
# needs a session-scoped setting to stick.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Neon Auth base URL. `neon-js` derives Auth and Data API URLs from
# DATABASE_URL when the object form is used, so this is only needed if you
# configure them explicitly.
NEON_AUTH_BASE_URL=https://auth-base-url

# Public application URL. Used for password-reset redirects and Neon Auth
# trusted domains. Production: https://promoleb.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Object storage (S3-compatible) — request attachments
# Credentials are per-branch and rotate on `neon deploy`. `neon env pull`
# refreshes them; do not hard-code.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=aws-us-east-2
AWS_ENDPOINT_URL_S3=https://your-storage-endpoint

# ---------------------------------------------------------------------------
# Deadline sweep
# Guards POST /api/health so the reminder job cannot be triggered by anyone
# who finds the URL. Unset = the endpoint is disabled and returns 503.
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET=replace-with-a-long-random-string